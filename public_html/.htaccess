Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:private|frontend|tests|vendor|\.git|\.env|\.vite)(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
</IfModule>
<FilesMatch "\.(?:sql|log|ini|bak|env|jsonl)$">
Require all denied
</FilesMatch>
